# E2E cpx shim：cpx 前缀的透传包装。真实 cpx 会包裹 claude 捕获会话；
# 矩阵 e2e 只验证「cpx 前缀被拼进 driver 命令」这一事实，直接转发给
# 同目录的 claude shim 即可。
set -euo pipefail
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude" "$@"
